{
  "name": "sillcast",
  "version": "0.1.0",
  "description": "Local-first indoor direct-sun planner for windows, plants, desks, and pet spots.",
  "type": "module",
  "license": "MIT",
  "author": "KanadeK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanadeK/sss.git"
  },
  "homepage": "https://sillcast-indoor-sun.kanadesama0602.chatgpt.site",
  "bugs": {
    "url": "https://github.com/KanadeK/sss/issues"
  },
  "keywords": [
    "sunlight",
    "solar-position",
    "houseplants",
    "indoor-light",
    "local-first",
    "privacy",
    "window",
    "typescript"
  ],
  "bin": {
    "sillcast": "./dist-package/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist-package/index.d.ts",
      "import": "./dist-package/index.js"
    }
  },
  "files": [
    "dist-package",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run build:package && npm run build:web",
    "build:web": "vite build",
    "build:package": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke",
    "package:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
